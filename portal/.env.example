# Security Operations Portal configuration. Variable names only; never commit
# real values. Production values come from the secrets mechanism.

# Portal MariaDB (separate from HOSxP and the Wazuh Indexer)
DATABASE_URL=mysql://portal:CHANGE_ME@127.0.0.1:3306/portal

# At least 32 random characters: openssl rand -base64 48
SESSION_SECRET=
# 32 random bytes, base64: openssl rand -base64 32
TOTP_ENCRYPTION_KEY=

# Public URL used in notification links (https only)
PORTAL_BASE_URL=https://portal.hospital.example

# Management VLAN and MFA VPN ranges allowed to reach the Portal
TRUSTED_NETWORKS=192.0.2.0/24

# Wazuh Indexer read-only service account (ADR 0006)
WAZUH_INDEXER_URL=https://192.0.2.20:9200
WAZUH_INDEXER_USERNAME=svc-portal
# Wazuh dashboard URL used for investigation links
WAZUH_DASHBOARD_URL=https://192.0.2.20
WAZUH_INDEXER_PASSWORD=
# Optional: CA certificate that signed the Indexer certificate
WAZUH_INDEXER_CA_CERT=
# Optional: seconds between alert polls (5-60, default 60)
WAZUH_POLL_INTERVAL_SECONDS=60

# Notifications (spec "Notifications"). Configure at least one channel; each
# message carries only severity, incident number, detection time, system name
# and Portal link.
# Email via SMTP with STARTTLS (port 587) or TLS (port 465)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=soc-portal@hospital.example
NOTIFY_EMAIL_TO=it-security@hospital.example
# LINE OA Messaging API channel access token and the group or user ID to push to
LINE_CHANNEL_ACCESS_TOKEN=
LINE_TO=

# Optional: Cloudflare GraphQL Analytics, read-only token (Zone > Analytics > Read)
# for the hospital zone. The WAF page shows sampled events only.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
