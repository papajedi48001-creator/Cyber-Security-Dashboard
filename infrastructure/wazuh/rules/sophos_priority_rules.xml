<!--
  Sophos Priority Signals (see ../priority-signals.md).
  Each child rule carries exactly one category group, which the Portal maps
  to a Security Event type. Sibling rules are mutually exclusive so an event
  alerts once. Custom rule ids: 100100-100199.
-->
<group name="sophos,">

  <rule id="100100" level="0">
    <decoded_as>sophos-sfos</decoded_as>
    <description>Sophos SFOS event</description>
  </rule>

  <rule id="100110" level="5">
    <if_sid>100100</if_sid>
    <field name="log_type" type="pcre2">^Firewall$</field>
    <field name="log_subtype" type="pcre2">^Denied$</field>
    <description>Sophos: traffic blocked by firewall rule (dst port $(dstport))</description>
    <group>blocked_traffic,</group>
  </rule>

  <rule id="100120" level="8">
    <if_sid>100100</if_sid>
    <field name="log_type" type="pcre2">^Event$</field>
    <field name="log_component" type="pcre2">^(GUI|CLI|Authentication|API|SSH|Console)$</field>
    <field name="status" type="pcre2">^Failed$</field>
    <description>Sophos: administrator or user login failure</description>
    <group>admin_or_login_failure,</group>
  </rule>

  <rule id="100130" level="10">
    <if_sid>100100</if_sid>
    <field name="log_type" type="pcre2">^Event$</field>
    <field name="log_subtype" type="pcre2">^Admin$</field>
    <field name="status" type="pcre2">^Successful$</field>
    <field name="message" type="pcre2">(?i)\b(firewall rule|nat rule|policy)\b.*\b(added|modified|deleted|updated|created)\b</field>
    <description>Sophos: firewall rule or policy changed</description>
    <group>firewall_rule_change,</group>
  </rule>

  <rule id="100140" level="8">
    <if_sid>100100</if_sid>
    <field name="log_type" type="pcre2">^Event$</field>
    <field name="log_component" type="pcre2">^(SSL VPN|IPSec|VPN|L2TP|PPTP|Sophos Connect)$</field>
    <field name="status" type="pcre2">^Failed$</field>
    <description>Sophos: VPN authentication or tunnel failure</description>
    <group>vpn_anomaly,</group>
  </rule>

  <rule id="100150" level="10">
    <if_sid>100100</if_sid>
    <field name="log_type" type="pcre2">^(IDP|Anti-Virus|Anti-Spam|Content Filtering|ATP|Sandstorm|Zero-day Protection)$</field>
    <field name="log_subtype" type="pcre2">^(Drop|Alert|Detect|Virus|Denied|Blocked|Malicious)$</field>
    <description>Sophos: IPS, antivirus or web protection event</description>
    <group>ips_av_web_event,</group>
  </rule>

</group>
