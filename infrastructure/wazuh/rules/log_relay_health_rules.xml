<!--
  Log Source Health from the TLS Log Relay. relay_health.py output is written
  as one JSON line per minute and read by the Wazuh agent on the relay
  (log_format json), so it arrives here through the built-in JSON decoder.
-->
<group name="log_relay,">

  <rule id="100180" level="0">
    <decoded_as>json</decoded_as>
    <field name="component" type="pcre2">^log_relay$</field>
    <description>TLS Log Relay health report</description>
  </rule>

  <rule id="100181" level="9">
    <if_sid>100180</if_sid>
    <field name="status" type="pcre2">^(degraded|unknown)$</field>
    <description>TLS Log Relay: events buffering or relay state unknown</description>
    <group>log_source_health,</group>
  </rule>

  <rule id="100182" level="12">
    <if_sid>100180</if_sid>
    <field name="status" type="pcre2">^failed$</field>
    <description>TLS Log Relay: events dropped before reaching Wazuh</description>
    <group>log_source_health,</group>
  </rule>

</group>
