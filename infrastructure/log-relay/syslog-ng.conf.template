@version: 4.2
# TLS Log Relay for Sophos Firewall -> Wazuh.
# Generated by render_config.py; do not edit the rendered file by hand.

options {
  use-dns(no);
  keep-hostname(yes);
  stats(freq(60));
  log-fifo-size(10000);
};

# Sophos sends RFC5424 Syslog over TLS. Clients must present a certificate
# signed by the hospital CA (peer-verify), and only allowlisted addresses are
# forwarded (f_allowed_sources).
source s_sophos_tls {
  network(
    ip("{{LISTEN_IP}}")
    port(6514)
    transport("tls")
    tls(
      key-file("{{TLS_DIR}}/relay.key")
      cert-file("{{TLS_DIR}}/relay.crt")
      ca-dir("{{TLS_DIR}}/ca.d")
      peer-verify(required-trusted)
    )
  );
};

filter f_allowed_sources {
{{ALLOWED_SOURCES_FILTER}}
};

# wazuh-remoted accepts Syslog over TCP only from the relay's address
# (allowed-ips in ossec.conf). The reliable disk buffer keeps events while
# Wazuh is down or being rebuilt; its size is finite so the disk cannot fill.
destination d_wazuh {
  network(
    "{{WAZUH_HOST}}"
    port({{WAZUH_PORT}})
    transport("tcp")
    disk-buffer(
      reliable(yes)
      disk-buf-size({{BUFFER_BYTES}})
      dir("{{STATE_DIR}}/buffer")
    )
  );
};

# Evidence of rejected senders: metadata only, no message body.
destination d_rejected {
  file(
    "{{STATE_DIR}}/rejected-senders.log"
    template("${ISODATE} rejected ${SOURCEIP}\n")
  );
};

log {
  source(s_sophos_tls);
  filter(f_allowed_sources);
  destination(d_wazuh);
  flags(flow-control);
};

log {
  source(s_sophos_tls);
  filter { not filter(f_allowed_sources); };
  destination(d_rejected);
};
