# /etc/systemd/system/hosxp-offsite-upload.timer — the nightly ZIP is finished by about 04:01.
# Later runs only retry files that did not arrive.
[Unit]
Description=Copy HOSxP daily backup files to GDCC

[Timer]
OnCalendar=*-*-* 05,08,12:00:00 Asia/Bangkok
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
