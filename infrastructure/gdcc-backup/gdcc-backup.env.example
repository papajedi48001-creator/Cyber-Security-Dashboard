# /etc/gdcc-backup/gdcc-backup.env (mode 0600, root). Names only; real values
# come from the Secrets Vault. Never commit the real file.

# GDCC object storage (S3-compatible) — one bucket path per host:
RESTIC_REPOSITORY=s3:https://objects.gdcc.example/hospital-backup/portal
# or a GDCC VM over SFTP:
# RESTIC_REPOSITORY=sftp:backup@198.51.100.30:/srv/restic/portal

# Write-only GDCC credential for this host (the maintenance host has its own)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Backup Encryption Key (restic repository password), file mode 0400.
# Escrowed in the Secrets Vault with Dual-Control Key Recovery.
RESTIC_PASSWORD_FILE=/etc/gdcc-backup/restic-password
RESTIC_CACHE_DIR=/var/cache/gdcc-backup
